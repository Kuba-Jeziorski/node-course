extends layouts/main-layout.pug

block styles 
  link(
    href="/css/product.css" 
    rel="stylesheet"
    )
  link(
    href="/css/forms.css" 
    rel="stylesheet"
    )

block content 
  main
    form.product-form(
      method="POST" 
      action="/admin/add-product"
      )
      .form-control
        label(for="title") Title
        input#title(
          name="title" 
          type="text"
          )
      button.btn(type="submit") Add Product